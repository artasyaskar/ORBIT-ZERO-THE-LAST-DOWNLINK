<!--
  ORBIT ZERO: THE LAST DOWNLINK — Ergonomic Overhead Tactical Visor & Evidence Inspector
  Designed per Meta Horizon OS Sept 2026 Spatial UI standards.
  Presents clear primary directive, aerospace resource telemetry, and tangible cube inspection.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 480px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: #060e1df0;
    border-radius: 16px;
    border-width: 2px;
    border-color: #0284c7;
  }

  .operation-title-bar {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-color: #1e3a5f;
  }

  .op-title-text {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #38bdf8;
  }

  .op-phase-text {
    font-size: 14px;
    font-weight: 700;
    color: #f59e0b;
  }

  .directive-banner {
    flex-direction: column;
    width: 100%;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: #0c4a6ecc;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: #38bdf8;
    margin-bottom: 10px;
  }

  .directive-text {
    font-size: 16px;
    font-weight: 800;
    line-height: 1.35;
    color: #ffffff;
  }

  .telemetry-header {
    flex-direction: column;
    width: 100%;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #0b1a2edd;
    border-radius: 8px;
    border-width: 1px;
    border-color: #0369a1;
    margin-bottom: 8px;
  }

  .resource-row {
    font-size: 17px;
    font-weight: 700;
    color: #38bdf8;
  }

  .window-row {
    font-size: 14px;
    font-weight: 700;
    color: #f59e0b;
    margin-top: 3px;
  }

  .inspector-card {
    flex-direction: column;
    width: 100%;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #0a172bdd;
    border-radius: 8px;
    border-width: 1px;
    border-color: #1e3a5f;
    margin-bottom: 8px;
  }

  .inspector-title {
    font-size: 15px;
    font-weight: 700;
    color: #f8fafc;
  }

  .inspector-meta {
    font-size: 14px;
    font-weight: 700;
    color: #10b981;
    margin-top: 2px;
  }

  .inspector-science {
    font-size: 13px;
    font-weight: 500;
    color: #cbd5e1;
    margin-top: 2px;
  }

  .action-btn {
    width: 100%;
    margin-top: 5px;
    justify-content: center;
    background-color: #0b1f3bee;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: #38bdf8;
    padding-top: 7px;
    padding-bottom: 7px;
  }
  .action-btn:hover {
    border-width: 3.5px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: #123a63ee;
  }
</style>
<Panel class="panel-root">
  <div class="operation-title-bar">
    <div id="OperationTitleText" class="op-title-text">ORBIT ZERO // OP 01: FIRELINE (BOLAN)</div>
    <div id="OperationPhaseBadge" class="op-phase-text">PHASE: RECON &amp; PROCESSING</div>
  </div>

  <div id="StatusBannerCard" class="directive-banner">
    <div id="StatusMessageText" class="directive-text" style="height: 70px; overflow: hidden;">
      &gt; STEP 1: Point at highlighted Sector B on the globe and pinch to acquire target.
    </div>
  </div>

  <div id="TelemetryHeaderCard" class="telemetry-header">
    <div id="ResourceReadout" class="resource-row">
      BATTERY -- | MEMORY --
    </div>
    <div id="WindowReadout" class="window-row">
      DOWNLINK: STANDBY
    </div>
  </div>

  <div id="CubeInspectorCard" class="inspector-card">
    <div id="InspectorTitle" class="inspector-title">
      ACTIVE EVIDENCE CUBE: NONE SELECTED
    </div>
    <div id="InspectorConfidence" class="inspector-meta">
      Scan a sector or grab/poke an Evidence Cube on the tray to inspect.
    </div>
    <div id="InspectorCost" class="inspector-science" style="color: #94a3b8; font-weight: 700;">-</div>
    <div id="InspectorScience" class="inspector-science" style="height: 78px; overflow: hidden;">
      Compress any cube with evidence to make it smaller. It cannot rescue a blocked [X] scan.
    </div>
  </div>

  <Button id="Btn_ProcessCube" class="action-btn">
    <ButtonLabel id="Lbl_ProcessCube" style="color: #f59e0b; font-size: 14px; font-weight: 700;">COMPRESS SELECTED CUBE</ButtonLabel>
  </Button>

  <Button id="Btn_QueueCube" class="action-btn">
    <ButtonLabel id="Lbl_QueueCube" style="color: #38bdf8; font-size: 14px; font-weight: 700;">ADD SELECTED CUBE TO DOWNLINK BAY</ButtonLabel>
  </Button>

  <Button id="Btn_DiscardCube" class="action-btn">
    <ButtonLabel id="Lbl_DiscardCube" style="color: #f87171; font-size: 14px; font-weight: 700;">DISCARD SELECTED CUBE (FREE STORAGE)</ButtonLabel>
  </Button>
  <Button id="Btn_CycleCube" class="action-btn">
    <ButtonLabel style="color: #e2e8f0; font-size: 14px; font-weight: 700;">SELECT NEXT EVIDENCE CUBE</ButtonLabel>
  </Button>
  <div id="AudioCaption" class="inspector-science" style="height: 36px; overflow: hidden;">GROUND CONTROL: one pass, three requests, one final downlink.</div>
  <div style="flex-direction: row; gap: 6px; width: 100%;">
    <Button id="Btn_Pause" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_Pause" style="color: #e2e8f0; font-size: 14px;">PAUSE PASS</ButtonLabel></Button>
    <Button id="Btn_Settings" class="action-btn" style="width: 48%;"><ButtonLabel style="color: #e2e8f0; font-size: 14px;">ACCESSIBILITY</ButtonLabel></Button>
  </div>
  <div id="AccessibilitySettings" style="display: none; flex-direction: column; width: 100%;">
    <div style="flex-direction: row; gap: 6px; width: 100%;">
      <Button id="Btn_Guidance" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_Guidance" style="color: #e2e8f0; font-size: 13px;">GUIDANCE: GUIDED</ButtonLabel></Button>
      <Button id="Btn_DominantHand" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_DominantHand" style="color: #e2e8f0; font-size: 13px;">SCANNER HAND: RIGHT</ButtonLabel></Button>
    </div>
    <div style="flex-direction: row; gap: 6px; width: 100%;">
      <Button id="Btn_OneHanded" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_OneHanded" style="color: #e2e8f0; font-size: 13px;">ONE-HAND ASSIST: OFF</ButtonLabel></Button>
      <Button id="Btn_LargeText" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_LargeText" style="color: #e2e8f0; font-size: 13px;">LARGE TEXT: OFF</ButtonLabel></Button>
    </div>
    <div style="flex-direction: row; gap: 6px; width: 100%;">
      <Button id="Btn_HighContrast" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_HighContrast" style="color: #e2e8f0; font-size: 13px;">HIGH CONTRAST: OFF</ButtonLabel></Button>
      <Button id="Btn_ReducedMotion" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_ReducedMotion" style="color: #e2e8f0; font-size: 13px;">REDUCED MOTION: OFF</ButtonLabel></Button>
    </div>
    <div style="flex-direction: row; gap: 6px; width: 100%;">
      <Button id="Btn_Captions" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_Captions" style="color: #e2e8f0; font-size: 13px;">CAPTIONS: ON</ButtonLabel></Button>
      <Button id="Btn_AudioLevel" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_AudioLevel" style="color: #e2e8f0; font-size: 13px;">AUDIO: 65%</ButtonLabel></Button>
    </div>
    <div style="flex-direction: row; gap: 6px; width: 100%;">
      <Button id="Btn_GazeAssist" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_GazeAssist" style="color: #38bdf8; font-size: 13px;">GAZE FOCUS: ON</ButtonLabel></Button>
      <Button id="Btn_RelaxedClock" class="action-btn" style="width: 48%;"><ButtonLabel id="Lbl_RelaxedClock" style="color: #fbbf24; font-size: 13px;">PASS CLOCK: ON</ButtonLabel></Button>
    </div>
    <div style="flex-direction: row; gap: 6px; width: 100%;">
      <Button id="Btn_CockpitSkin" class="action-btn" style="width: 100%;"><ButtonLabel id="Lbl_CockpitSkin" style="color: #38bdf8; font-size: 13px;">TRIM SKIN: CYAN</ButtonLabel></Button>
    </div>
  </div>
</Panel>
