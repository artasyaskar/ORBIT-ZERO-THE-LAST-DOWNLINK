    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e-runtime.mjs",
    "test:rc9": "node tests/e2e-spatial-rc9.mjs",
    "test:virtual-quest": "node tests/virtual-quest/virtualQuestLab.mjs",
    "test:headset": "node tests/virtual-headset-player.mjs",
    "test:desktop": "node tests/e2e-redesign-desktop.mjs",
    "test:deploy": "node tests/deploy-static-check.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.181.0",
    "iwer": "^2.7.0",
    "playwright": "^1.64.1",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
